{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liu2024whu-bit/starshine/schemas/reproduction-report-v1.schema.json",
  "title": "Starshine installed-core reproduction report version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "starshine_version",
    "python",
    "platform",
    "doctor_valid",
    "geopackage_available",
    "operator_count",
    "output_feature_count",
    "output_digest",
    "reproduced_steps"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "ok"},
    "starshine_version": {"type": "string", "minLength": 1},
    "python": {"$ref": "#/$defs/environment"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "machine"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "machine": {"type": "string", "minLength": 1}
      }
    },
    "doctor_valid": {"const": true},
    "geopackage_available": {"type": "boolean"},
    "operator_count": {"type": "integer", "minimum": 1},
    "output_feature_count": {"const": 3},
    "output_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reproduced_steps": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}
