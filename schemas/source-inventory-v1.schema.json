{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liu2024whu-bit/starshine/schemas/source-inventory-v1.schema.json",
  "title": "Starshine Source Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_format",
    "layer_count",
    "bounds_requested",
    "feature_count_forced",
    "layers"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_format": {"enum": ["geojson", "geopackage"]},
    "layer_count": {"type": "integer", "minimum": 1},
    "bounds_requested": {"type": "boolean"},
    "feature_count_forced": {"type": "boolean"},
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/layer"}
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "oneOf": [
        {"required": ["type"]},
        {"required": ["types"]}
      ]
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "spatial",
        "geometry_type",
        "crs_status",
        "crs",
        "fields",
        "feature_count_status",
        "feature_count"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "spatial": {"type": "boolean"},
        "geometry_type": {"type": ["string", "null"]},
        "crs_status": {"enum": ["declared", "missing", "not_applicable"]},
        "crs": {"type": ["string", "null"]},
        "fields": {
          "type": "array",
          "items": {"$ref": "#/$defs/field"}
        },
        "feature_count_status": {"enum": ["known", "unknown"]},
        "feature_count": {"type": ["integer", "null"], "minimum": 0},
        "bounds": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {"type": "number"}
            }
          ]
        }
      }
    }
  }
}
