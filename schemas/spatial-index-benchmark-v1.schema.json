{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liu2024whu-bit/starshine/schemas/spatial-index-benchmark-v1.schema.json",
  "title": "Starshine deterministic spatial-index benchmark version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_version",
    "corpus_version",
    "starshine_version",
    "shapely_version",
    "python",
    "platform",
    "repeat_count",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_version": {
      "const": 1
    },
    "corpus_version": {
      "const": 7
    },
    "starshine_version": {
      "type": "string",
      "minLength": 1
    },
    "shapely_version": {
      "type": "string",
      "minLength": 1
    },
    "python": {
      "$ref": "#/$defs/pythonEnvironment"
    },
    "platform": {
      "$ref": "#/$defs/platformEnvironment"
    },
    "repeat_count": {
      "type": "integer",
      "minimum": 1
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timingSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samples_seconds",
        "minimum_seconds",
        "median_seconds"
      ],
      "properties": {
        "samples_seconds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "minimum_seconds": {
          "type": "number",
          "minimum": 0
        },
        "median_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source_feature_count",
        "candidate_feature_count",
        "exhaustive_pair_count",
        "semantic_digest",
        "reference_semantic_digest",
        "semantic_equal",
        "timing",
        "observed_speedup"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source_feature_count": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_feature_count": {
          "type": "integer",
          "minimum": 1
        },
        "exhaustive_pair_count": {
          "type": "integer",
          "minimum": 1
        },
        "semantic_digest": {
          "$ref": "#/$defs/digest"
        },
        "reference_semantic_digest": {
          "$ref": "#/$defs/digest"
        },
        "semantic_equal": {
          "const": true
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "indexed_public_api",
            "exhaustive_reference"
          ],
          "properties": {
            "indexed_public_api": {
              "$ref": "#/$defs/timingSummary"
            },
            "exhaustive_reference": {
              "$ref": "#/$defs/timingSummary"
            }
          }
        },
        "observed_speedup": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      }
    },
    "pythonEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "version"
      ],
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "platformEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "machine"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
